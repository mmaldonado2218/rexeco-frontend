---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBlock from '../components/astro/ContactBlock.astro';
import SocialLinks from '../components/astro/SocialLinks.astro';
import MarcasGrid from '../components/astro/MarcasGrid.astro';
import ContactForm from '../components/react/ContactForm';
---

<BaseLayout
  title="Contacto – Grupo Rexeco"
  description="Contacta a Grupo Rexeco. RESIMEX – EXXAN – ECONORTE. Gestión integral de residuos en Chile."
>
  <!-- Hero contacto -->
  <section class="py-20 bg-rexeco-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-rexeco-red font-heading font-semibold text-sm uppercase tracking-[0.2em] mb-4">
        CONTÁCTANOS
      </p>
      <h1 class="font-heading font-bold text-white text-4xl sm:text-5xl lg:text-6xl uppercase tracking-wide mb-4">
        CONTÁCTANOS
      </h1>
      <p class="text-white/60 text-lg max-w-xl">
        RESIMEX – EXXAN – ECONORTE
      </p>
    </div>
  </section>

  <!-- Contenido principal -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-start">

        <!-- Formulario -->
        <div>
          <h2 class="font-heading font-bold text-rexeco-dark text-2xl sm:text-3xl uppercase tracking-wide mb-2">
            Déjanos tus datos
          </h2>
          <p class="text-rexeco-text text-sm mb-8">
            Déjanos tus datos y nos contactaremos contigo.
          </p>
          <ContactForm client:visible />
        </div>

        <!-- Info de contacto -->
        <div class="lg:pl-8">
          <div class="mb-10">
            <h2 class="font-heading font-bold text-rexeco-dark text-2xl sm:text-3xl uppercase tracking-wide mb-8">
              GRUPO REXECO
            </h2>
            <ContactBlock />
          </div>

          <div class="border-t border-gray-100 pt-8">
            <p class="font-heading font-semibold text-rexeco-dark text-xs uppercase tracking-widest mb-4">
              Síguenos en:
            </p>
            <SocialLinks variant="light" />
          </div>
        </div>

      </div>
    </div>
  </section>

  <MarcasGrid />
</BaseLayout>
