---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import ContactForm from '../components/react/ContactForm';
import instalaciones from '../assets/cards/resimex-386.png';
import { SITE } from '../data/site';
---

<BaseLayout
  title="Contacto – Grupo Rexeco"
  description="Contacta a Grupo Rexeco. RESIMEX – EXXAN – ECONORTE. Gestión integral de residuos en Chile."
>
  <!-- Hero contacto -->
  <section class="py-20 bg-rexeco-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-rexeco-red font-heading font-semibold text-sm uppercase tracking-[0.2em] mb-4">
        CONTÁCTANOS
      </p>
      <h1 class="font-heading font-bold text-white text-4xl sm:text-5xl lg:text-6xl uppercase tracking-wide mb-4">
        CONTÁCTANOS
      </h1>
      <p class="text-white/60 text-lg max-w-xl">
        RESIMEX – EXXAN – ECONORTE
      </p>
    </div>
  </section>

  <!-- Formulario + Info -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Kicker -->
      <p class="text-rexeco-red font-heading font-semibold text-xs uppercase tracking-[0.2em] mb-8 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-rexeco-red inline-block"></span>
        GRUPO REXECO
      </p>

      <div class="grid lg:grid-cols-2 gap-16 items-start">

        <!-- Formulario -->
        <div data-animate="left">
          <h2 class="font-heading font-bold text-rexeco-dark text-3xl sm:text-4xl leading-tight mb-8">
            Déjanos tus datos y nos contactaremos contigo.
          </h2>
          <ContactForm client:visible />
        </div>

        <!-- Columna derecha -->
        <div data-animate="right" class="space-y-6">
          <div>
            <h3 class="font-heading font-bold text-rexeco-dark text-2xl mb-3">Grupo Rexeco</h3>
            <p class="text-rexeco-text text-sm leading-relaxed">
              RESIMEX – EXXAN – ECONORTE. Grupo de empresas especializadas en reciclaje y gestión integral de residuos, comprometidos con la economía circular y el cuidado del medio ambiente.
            </p>
          </div>

          <!-- Imagen instalaciones -->
          <Image
            src={instalaciones}
            alt="Instalaciones Grupo Rexeco"
            class="w-full h-56 object-cover rounded-xl"
            widths={[600, 900]}
            sizes="(max-width: 1024px) 100vw, 50vw"
          />

          <!-- Redes sociales -->
          <div>
            <p class="font-heading font-bold text-rexeco-dark text-lg mb-4">Síguenos en:</p>
            <div class="flex items-center gap-5">
              <a href={SITE.redes.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="text-rexeco-dark hover:text-rexeco-red transition-colors">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              </a>
              <a href={SITE.redes.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="text-rexeco-dark hover:text-rexeco-red transition-colors">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
              </a>
              <a href="#" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="text-rexeco-dark hover:text-rexeco-red transition-colors">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
                </svg>
              </a>
              <a href="#" target="_blank" rel="noopener noreferrer" aria-label="TikTok" class="text-rexeco-dark hover:text-rexeco-red transition-colors">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.18 8.18 0 004.77 1.52V6.76a4.85 4.85 0 01-1-.07z"/>
                </svg>
              </a>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Mapa Google Maps -->
  <section class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="w-full h-80 lg:h-[420px]">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3328.5!2d-70.699!3d-33.599!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9662c0a0a0a0a0a1%3A0x1!2sSta.+Margarita+01821%2C+San+Bernardo!5e0!3m2!1ses!2scl!4v1"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Ubicación Grupo Rexeco - Sta. Margarita 01821, San Bernardo"
        ></iframe>
      </div>
    </div>
  </section>

</BaseLayout>
