---
import { Image } from 'astro:assets';
import slider1 from '../../assets/hero/home-slider-1.jpg';
import slider2 from '../../assets/hero/home-slider-2.jpg';
import slider3 from '../../assets/hero/home-slider-3.jpg';
import { SITE } from '../../data/site';

const slides = [
  { img: slider1, alt: 'Grupo Rexeco – Instalaciones' },
  { img: slider2, alt: 'Grupo Rexeco – Operaciones' },
  { img: slider3, alt: 'Grupo Rexeco – Reciclaje' },
];
---

<section
  id="hero-slider"
  class="relative h-[92vh] min-h-[560px] max-h-[900px] overflow-hidden bg-rexeco-dark"
>
  <!-- Shimmer placeholder visible hasta que cargue la primera imagen -->
  <div id="hero-shimmer" class="absolute inset-0 z-[5] bg-rexeco-dark">
    <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/5 to-transparent animate-[shimmer_1.5s_ease-in-out_infinite] bg-[length:200%_100%]"></div>
  </div>

  <!-- Imágenes -->
  {slides.map((slide, i) => (
    <div
      class={`hero-slide absolute inset-0 transition-opacity duration-1000 ${i === 0 ? 'opacity-100' : 'opacity-0'}`}
      aria-hidden={i !== 0 ? 'true' : 'false'}
    >
      <Image
        src={slide.img}
        alt={slide.alt}
        class="w-full h-full object-cover object-center"
        widths={[768, 1280, 1920]}
        sizes="100vw"
        loading={i === 0 ? 'eager' : 'lazy'}
        fetchpriority={i === 0 ? 'high' : 'auto'}
        quality={80}
        {...(i === 0 ? { id: 'hero-first-img' } : {})}
      />
    </div>
  ))}

  <!-- Overlay -->
  <div class="absolute inset-0 bg-rexeco-dark/60" />

  <!-- Contenido hero -->
  <div class="relative z-10 h-full flex items-center">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
      <div class="max-w-3xl">
        <p class="text-rexeco-red font-heading font-semibold text-sm sm:text-base uppercase tracking-[0.2em] mb-4">
          RECICLAJE INTELIGENTE, CIUDAD MÁS LIMPIA
        </p>
        <h1 class="font-heading font-bold text-white text-4xl sm:text-5xl lg:text-6xl xl:text-7xl leading-tight mb-6">
          Transformando residuos en oportunidades
        </h1>
        <p class="text-white/80 text-lg sm:text-xl leading-relaxed mb-10 max-w-xl">
          En Grupo Rexeco creemos en el poder del reciclaje para construir un futuro más verde y sostenible.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href={SITE.whatsapp.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 bg-rexeco-red hover:bg-red-700 text-white font-heading font-bold uppercase tracking-wide px-8 py-4 text-base transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Contáctanos
          </a>
          <a
            href="/#nosotros"
            class="inline-flex items-center justify-center gap-2 border-2 border-white text-white hover:bg-white hover:text-rexeco-dark font-heading font-bold uppercase tracking-wide px-8 py-4 text-base transition-colors"
          >
            Sobre nosotros
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Flecha anterior -->
  <button
    id="slider-prev"
    aria-label="Imagen anterior"
    class="absolute left-4 lg:left-8 top-1/2 -translate-y-1/2 z-20 w-11 h-11 flex items-center justify-center bg-white/15 hover:bg-white/30 text-white backdrop-blur-sm transition-colors rounded-full"
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
    </svg>
  </button>

  <!-- Flecha siguiente -->
  <button
    id="slider-next"
    aria-label="Imagen siguiente"
    class="absolute right-4 lg:right-8 top-1/2 -translate-y-1/2 z-20 w-11 h-11 flex items-center justify-center bg-white/15 hover:bg-white/30 text-white backdrop-blur-sm transition-colors rounded-full"
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </button>

  <!-- Dots -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex gap-3 z-20">
    {slides.map((_, i) => (
      <button
        class={`slider-dot h-1 w-8 transition-all duration-300 ${i === 0 ? 'bg-rexeco-red' : 'bg-white/40 hover:bg-white/70'}`}
        aria-label={`Ir a imagen ${i + 1}`}
        data-index={String(i)}
      />
    ))}
  </div>
</section>

<script>
  // Ocultar shimmer cuando la primera imagen cargue
  const firstImg = document.getElementById('hero-first-img') as HTMLImageElement | null;
  const shimmer = document.getElementById('hero-shimmer');
  if (shimmer && firstImg) {
    const hide = () => {
      shimmer.style.transition = 'opacity 0.4s ease';
      shimmer.style.opacity = '0';
      setTimeout(() => shimmer.remove(), 400);
    };
    if (firstImg.complete && firstImg.naturalWidth > 0) {
      hide();
    } else {
      firstImg.addEventListener('load', hide, { once: true });
      firstImg.addEventListener('error', hide, { once: true });
    }
  }

  const INTERVAL = 8500;

  const slides = document.querySelectorAll<HTMLElement>('.hero-slide');
  const dots = document.querySelectorAll<HTMLElement>('.slider-dot');
  let current = 0;
  let timer: ReturnType<typeof setInterval>;

  function goTo(index: number) {
    slides[current].classList.replace('opacity-100', 'opacity-0');
    slides[current].setAttribute('aria-hidden', 'true');
    dots[current].classList.remove('bg-rexeco-red');
    dots[current].classList.add('bg-white/40');

    current = ((index % slides.length) + slides.length) % slides.length;

    slides[current].classList.replace('opacity-0', 'opacity-100');
    slides[current].setAttribute('aria-hidden', 'false');
    dots[current].classList.remove('bg-white/40');
    dots[current].classList.add('bg-rexeco-red');
  }

  function startTimer() {
    timer = setInterval(() => goTo(current + 1), INTERVAL);
  }

  function resetTimer() {
    clearInterval(timer);
    startTimer();
  }

  document.getElementById('slider-prev')?.addEventListener('click', () => { goTo(current - 1); resetTimer(); });
  document.getElementById('slider-next')?.addEventListener('click', () => { goTo(current + 1); resetTimer(); });

  dots.forEach((dot) => {
    dot.addEventListener('click', () => { goTo(Number(dot.dataset.index)); resetTimer(); });
  });

  const section = document.getElementById('hero-slider')!;
  section.addEventListener('mouseenter', () => clearInterval(timer));
  section.addEventListener('mouseleave', startTimer);

  startTimer();
</script>
