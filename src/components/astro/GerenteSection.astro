---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Carrusel de departamentos. Cada slide sale de una foto en
// assets/people/departamentos/ cuyo nombre de archivo calza con el `slug`.
// Un departamento sin foto simplemente no se muestra: así basta con dejar
// caer "finanzas.jpg", "contabilidad.jpg" o "informatica.jpg" en esa carpeta
// para que aparezca su slide, sin tocar código.
const departamentos = [
  {
    slug: 'jefaturas',
    nombre: 'Nuestras Jefaturas',
    bajada: 'Comprometidos con un mundo mejor',
    // Encuadre propio de esta foto: el grupo queda chico en el original.
    imgClass: 'scale-[1.3]',
  },
  {
    slug: 'finanzas',
    nombre: 'Finanzas',
    bajada: 'Gestión financiera y control de costos de todo el grupo',
  },
  {
    slug: 'contabilidad',
    nombre: 'Contabilidad',
    bajada: 'Registro contable y cumplimiento tributario',
  },
  {
    slug: 'informatica',
    nombre: 'Informática',
    bajada: 'Sistemas, infraestructura y soporte tecnológico',
  },
];

const fotosGlob = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/people/departamentos/*.{jpg,JPG,jpeg,JPEG,png,PNG}',
  { eager: true }
);

// Índice nombre-de-archivo (sin extensión, normalizado) -> ImageMetadata.
const fotosPorSlug: Record<string, ImageMetadata> = {};
for (const [path, mod] of Object.entries(fotosGlob)) {
  const nombre = decodeURIComponent(path).split('/').at(-1)!.replace(/\.[^.]+$/, '');
  const slug = nombre
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .toLowerCase();
  fotosPorSlug[slug] = mod.default;
}

const slides = departamentos
  .map((dep) => ({ ...dep, img: fotosPorSlug[dep.slug] }))
  .filter((dep) => dep.img);

const hayCarrusel = slides.length > 1;
---

<section class="py-20 lg:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">

      <!-- Texto -->
      <div data-animate="left" class="order-2 lg:order-1">
        <p class="text-rexeco-red font-heading font-semibold text-sm uppercase tracking-[0.2em] mb-4">
          NUESTRO EQUIPO
        </p>
        <h2 class="font-heading font-bold text-rexeco-dark text-3xl sm:text-4xl lg:text-5xl leading-tight mb-8">
          Nos dedicamos a la gestión de residuos metálicos ferrosos y no ferrosos, de forma absolutamente responsable.
        </h2>

        <div class="space-y-8">
          <!-- Relaciones Comerciales -->
          <div class="flex items-start gap-5">
            <div class="flex-shrink-0 w-12 h-12 bg-rexeco-red flex items-center justify-center rounded-lg">
              <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />
              </svg>
            </div>
            <div>
              <h3 class="font-heading font-bold text-rexeco-dark text-lg uppercase tracking-wide mb-1">
                Relaciones Comerciales
              </h3>
              <p class="text-rexeco-text text-sm leading-relaxed">
                La lealtad hacia nuestros clientes y proveedores es un principio fundamental. Las relaciones comerciales se sustentan en la confianza, la transparencia y la eficiencia.
              </p>
            </div>
          </div>

          <div class="border-t border-gray-100"></div>

          <!-- Objetivo -->
          <div class="flex items-start gap-5">
            <div class="flex-shrink-0 w-12 h-12 bg-rexeco-dark flex items-center justify-center rounded-lg">
              <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.115 5.19l.319 1.913A6 6 0 008.11 10.36L9.75 12l-.387.775c-.217.433-.132.956.21 1.298l1.348 1.348c.21.21.329.497.329.795v1.089c0 .426.24.815.622 1.006l.153.076c.433.217.956.132 1.298-.21l.723-.723a8.7 8.7 0 002.288-4.042 1.087 1.087 0 00-.358-1.099l-1.33-1.108c-.251-.21-.582-.299-.905-.245l-1.17.195a1.125 1.125 0 01-.98-.314l-.295-.295a1.125 1.125 0 010-1.591l.13-.132a1.125 1.125 0 011.3-.21l.603.302a.809.809 0 001.086-1.086L14.25 7.5l1.256-.837a4.5 4.5 0 001.528-1.732l.146-.292M6.115 5.19A9 9 0 1017.18 4.64M6.115 5.19A8.965 8.965 0 0112 3c1.929 0 3.716.607 5.18 1.64" />
              </svg>
            </div>
            <div>
              <h3 class="font-heading font-bold text-rexeco-dark text-lg uppercase tracking-wide mb-1">
                Objetivo
              </h3>
              <p class="text-rexeco-text text-sm leading-relaxed">
                Lograr la plena satisfacción de nuestros clientes y proveedores, fortaleciendo las relaciones a través de su fidelización y complacencia.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Carrusel de departamentos -->
      <div data-animate="right" class="order-1 lg:order-2 flex justify-center lg:justify-end">
        <div
          id="deptos-carrusel"
          class="w-full overflow-hidden rounded-2xl"
          data-carrusel={hayCarrusel ? 'true' : 'false'}
        >
          <div class="relative aspect-[16/9] overflow-hidden">
            {slides.map((dep, i) => (
              <div
                class={`depto-slide absolute inset-0 transition-opacity duration-700 ${i === 0 ? 'opacity-100' : 'opacity-0'}`}
                aria-hidden={i !== 0 ? 'true' : 'false'}
              >
                <Image
                  src={dep.img!}
                  alt={`${dep.nombre} – Grupo Rexeco`}
                  width={1000}
                  height={625}
                  class={`w-full h-full object-cover object-center ${dep.imgClass ?? ''}`}
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
              </div>
            ))}

            {hayCarrusel && (
              <>
                <button
                  id="deptos-prev"
                  aria-label="Departamento anterior"
                  class="absolute left-3 top-1/2 -translate-y-1/2 z-20 w-10 h-10 flex items-center justify-center bg-black/30 hover:bg-black/50 text-white backdrop-blur-sm transition-colors rounded-full"
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                  </svg>
                </button>
                <button
                  id="deptos-next"
                  aria-label="Departamento siguiente"
                  class="absolute right-3 top-1/2 -translate-y-1/2 z-20 w-10 h-10 flex items-center justify-center bg-black/30 hover:bg-black/50 text-white backdrop-blur-sm transition-colors rounded-full"
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </button>
              </>
            )}
          </div>

          <div class="bg-rexeco-dark text-white px-6 py-5 flex items-center justify-between gap-4">
            <!-- Los captions se apilan en la misma celda de grid para que el
                 cruce sea un fundido a la par de la foto (no un salto seco). -->
            <div class="grid min-w-0">
              {slides.map((dep, i) => (
                <div
                  class={`depto-caption col-start-1 row-start-1 transition-opacity duration-300 ${i === 0 ? 'opacity-100' : 'opacity-0'}`}
                  aria-hidden={i !== 0 ? 'true' : 'false'}
                >
                  <p class="font-heading font-bold text-lg uppercase tracking-widest">{dep.nombre}</p>
                  <p class="font-heading font-semibold text-white text-sm uppercase tracking-wide mt-1">{dep.bajada}</p>
                </div>
              ))}
            </div>

            {hayCarrusel && (
              <div class="flex gap-2 shrink-0">
                {slides.map((dep, i) => (
                  <button
                    class={`depto-dot h-1 w-6 transition-all duration-300 ${i === 0 ? 'bg-rexeco-red' : 'bg-white/40 hover:bg-white/70'}`}
                    aria-label={`Ir a ${dep.nombre}`}
                    data-index={String(i)}
                  />
                ))}
              </div>
            )}
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const carrusel = document.getElementById('deptos-carrusel');
  if (carrusel?.dataset.carrusel === 'true') {
    const INTERVAL = 7000;
    const slides = carrusel.querySelectorAll<HTMLElement>('.depto-slide');
    const captions = carrusel.querySelectorAll<HTMLElement>('.depto-caption');
    const dots = carrusel.querySelectorAll<HTMLElement>('.depto-dot');
    let current = 0;
    let timer: ReturnType<typeof setInterval>;
    let swapCaption: ReturnType<typeof setTimeout>;

    function goTo(index: number) {
      slides[current].classList.replace('opacity-100', 'opacity-0');
      slides[current].setAttribute('aria-hidden', 'true');
      captions[current].classList.replace('opacity-100', 'opacity-0');
      captions[current].setAttribute('aria-hidden', 'true');
      dots[current].classList.remove('bg-rexeco-red');
      dots[current].classList.add('bg-white/40');

      current = ((index % slides.length) + slides.length) % slides.length;

      slides[current].classList.replace('opacity-0', 'opacity-100');
      slides[current].setAttribute('aria-hidden', 'false');
      dots[current].classList.remove('bg-white/40');
      dots[current].classList.add('bg-rexeco-red');

      // El caption entra recién cuando el saliente terminó de desvanecerse:
      // están apilados en la misma celda y superponerlos deja el texto ilegible.
      clearTimeout(swapCaption);
      swapCaption = setTimeout(() => {
        captions[current].classList.replace('opacity-0', 'opacity-100');
        captions[current].setAttribute('aria-hidden', 'false');
      }, 300);
    }

    const startTimer = () => { timer = setInterval(() => goTo(current + 1), INTERVAL); };
    const resetTimer = () => { clearInterval(timer); startTimer(); };

    document.getElementById('deptos-prev')?.addEventListener('click', () => { goTo(current - 1); resetTimer(); });
    document.getElementById('deptos-next')?.addEventListener('click', () => { goTo(current + 1); resetTimer(); });
    dots.forEach((dot) => {
      dot.addEventListener('click', () => { goTo(Number(dot.dataset.index)); resetTimer(); });
    });

    carrusel.addEventListener('mouseenter', () => clearInterval(timer));
    carrusel.addEventListener('mouseleave', startTimer);

    startTimer();
  }
</script>
