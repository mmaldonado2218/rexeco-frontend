---
import logoGrupo from '../../assets/logos/Logos Rexeco-01.svg';
import logoEcoNorte from '../../assets/logos/Logos Rexeco-02.svg';
import logoResimex from '../../assets/logos/Logos Rexeco-03.svg';
import logoExxan from '../../assets/logos/Logos Rexeco-04.svg';

const logos = [
  { src: logoGrupo.src,    alt: 'Grupo Rexeco' },
  { src: logoEcoNorte.src, alt: 'EcoNorte' },
  { src: logoResimex.src,  alt: 'Resimex' },
  { src: logoExxan.src,    alt: 'Exxan' },
];
---

<section class="py-12 bg-white border-y border-gray-100 overflow-hidden w-full">
  <div class="marquee-track flex items-center">
    {[...logos, ...logos, ...logos, ...logos].map((logo, i) => (
      <div class="flex items-center shrink-0 px-12">
        <img
          src={logo.src}
          alt={i < logos.length ? logo.alt : ''}
          aria-hidden={i >= logos.length ? 'true' : 'false'}
          class="h-12 w-auto object-contain grayscale hover:grayscale-0 transition-all opacity-60 hover:opacity-100"
        />
      </div>
    ))}
  </div>
</section>
