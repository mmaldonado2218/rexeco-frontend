---
// Testimonial video section. The video lives in public/ (served as-is, not
// processed by the bundler), so paths are absolute and not imported.
---

<!-- Dark brand background turns the side whitespace into intentional negative
     space instead of an empty gap around the vertical 9:16 video. -->
<section class="relative overflow-hidden bg-rexeco-dark py-20 lg:py-28">
  <!-- Subtle radial brand glow so the dark background reads as designed, not flat -->
  <div
    class="pointer-events-none absolute inset-0 opacity-60"
    style="background: radial-gradient(60% 60% at 50% 0%, rgba(204,10,38,0.18) 0%, transparent 70%);"
    aria-hidden="true"
  >
  </div>

  <div class="relative max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header sección -->
    <div data-animate="up" class="mb-12 text-center">
      <p class="text-rexeco-red font-heading font-semibold text-sm uppercase tracking-[0.2em] mb-4">
        TESTIMONIOS
      </p>
      <h2 class="font-heading font-bold text-white text-3xl sm:text-4xl lg:text-5xl leading-tight">
        Lo que dicen nuestros clientes
      </h2>
      <p class="mt-4 text-white/60 text-base sm:text-lg leading-relaxed max-w-md mx-auto">
        Empresas e industrias que confían en Grupo Rexeco para la gestión de sus materiales.
      </p>
    </div>

    <!-- Video (vertical 9:16) sobre tarjeta que flota sobre el fondo oscuro -->
    <div
      data-animate="up"
      class="max-w-sm mx-auto rounded-2xl overflow-hidden shadow-2xl ring-1 ring-white/10"
    >
      <video
        controls
        preload="none"
        playsinline
        poster="/videos/testimonial-alex-poster.jpg"
        class="w-full aspect-[9/16] bg-black"
      >
        <source src="/videos/testimonial-alex.mp4" type="video/mp4" />
        Tu navegador no soporta la reproducción de video.
      </video>
    </div>

  </div>
</section>
