---
import logo from '../../assets/logos/Logos Rexeco-05.svg';
import SocialLinks from './SocialLinks.astro';
import { SITE } from '../../data/site';
---

<footer class="bg-rexeco-dark text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10">

      <!-- Col 1: Sobre Nosotros -->
      <div>
        <h2 class="font-heading font-bold text-white text-base uppercase tracking-widest mb-4">
          Sobre Nosotros
        </h2>
        <p class="text-white/60 text-sm leading-relaxed mb-6">
          {SITE.descripcion}
        </p>
        <SocialLinks variant="dark" />
      </div>

      <!-- Col 2: Nuestras Empresas -->
      <div>
        <h2 class="font-heading font-bold text-white text-base uppercase tracking-widest mb-4">
          Nuestras Empresas
        </h2>
        <ul class="space-y-2">
          <li>
            <a href="/" class="text-white/60 hover:text-rexeco-red text-sm transition-colors">Grupo Rexeco</a>
          </li>
          <li>
            <a href="/exxan" class="text-white/60 hover:text-rexeco-red text-sm transition-colors">Exxan</a>
          </li>
          <li>
            <a href="/resimex" class="text-white/60 hover:text-rexeco-red text-sm transition-colors">Resimex</a>
          </li>
          <li>
            <a href="/econorte" class="text-white/60 hover:text-rexeco-red text-sm transition-colors">EcoNorte</a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Contacto rápido -->
      <div>
        <h2 class="font-heading font-bold text-white text-base uppercase tracking-widest mb-4">
          Contacto
        </h2>
        <ul class="space-y-3">
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-rexeco-red shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
            </svg>
            <a href={`mailto:${SITE.email}`} class="text-white/60 hover:text-white text-sm transition-colors">
              {SITE.email}
            </a>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-rexeco-red shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
            <span class="text-white/60 text-sm">{SITE.direccion}</span>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-rexeco-red shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            <a href={SITE.whatsapp.url} target="_blank" rel="noopener noreferrer" class="text-white/60 hover:text-white text-sm transition-colors">
              {SITE.whatsapp.numero}
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Logo -->
      <div class="flex flex-col items-start lg:items-start">
        <a href="/" aria-label="Grupo Rexeco">
          <img
            src={logo.src}
            alt="Grupo Rexeco"
            class="h-20 w-auto mb-4"
          />
        </a>
        <a
          href={SITE.whatsapp.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-rexeco-red hover:bg-red-700 text-white font-heading font-semibold text-xs uppercase tracking-wide px-4 py-2.5 transition-colors"
        >
          Contáctanos
        </a>
      </div>

    </div>
  </div>

  <!-- Barra inferior -->
  <div class="border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5 flex flex-col sm:flex-row items-center justify-between gap-2">
      <p class="text-white/40 text-xs">{SITE.copyright}</p>
      <p class="text-white/40 text-xs">RESIMEX – EXXAN – ECONORTE</p>
    </div>
  </div>
</footer>
