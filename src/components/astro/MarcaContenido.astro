---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import ContactBlock from './ContactBlock.astro';
import { SITE } from '../../data/site';

interface Props {
  marca: CollectionEntry<'marcas'>;
}
