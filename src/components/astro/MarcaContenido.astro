const fallbackIcon = `<path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>`;

const getIcon = (titulo: string) => iconMap[titulo] ?? fallbackIcon;

const queHacemosIconsBySlug: Record<string, { color: string; icons: string[] }> = {
