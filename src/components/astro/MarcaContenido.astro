type MaterialRich = { titulo: string; descripcion: string | string[] };
const recibidosRich = d.materialesRecibimos?.every(m => typeof m === 'object') ?? false;
const recibidosRichItems = recibidosRich ? (d.materialesRecibimos as MaterialRich[]) : [];
const recibidosSimpleItems = !recibidosRich ? (d.materialesRecibimos as string[] | undefined) : undefined;

const noRecibidosRich = d.materialesNoRecibimos?.every(m => typeof m === 'object') ?? false;
const noRecibidosRichItems = noRecibidosRich ? (d.materialesNoRecibimos as MaterialRich[]) : [];
const noRecibidosSimpleItems = !noRecibidosRich ? (d.materialesNoRecibimos as string[] | undefined) : undefined;

// --- Carrusel de fotos por material (PhotoSwipe) ---
// Cada slide necesita src/width/height. Las dimensiones se leen del ImageMetadata
// original; getImage() genera la URL WebP optimizada (los JPG pesan 7-19MB).
// El resultado se acumula en pswpPorCategoria (clave = título de card), que
// alimenta el render y el script por igual. Card no presente => no clickable.
type PswpSlide = { src: string; width: number; height: number; alt: string };
const pswpPorCategoria: Record<string, PswpSlide[]> = {};
// Resimex: click por ÍTEM individual (Perfil A, UBC, Offset...) -> su única foto.
// Clave = texto exacto del ítem en el .md; valor = slide de su archivo.
const pswpPorItem: Record<string, PswpSlide> = {};

async function metaASlide(meta: ImageMetadata, alt: string): Promise<PswpSlide> {
  const opt = await getImage({ src: meta, format: 'webp', quality: 78 });
  return { src: opt.src, width: meta.width, height: meta.height, alt };
}

// Patrón "1 card -> 1 carpeta-categoría con N fotos". Agrupa los archivos del
// glob por la carpeta-categoría (el segmento de path justo después de la marca),
// sin importar si hay subcarpetas debajo, y según el mapa título->carpeta arma
// los slides de cada card. (import.meta.glob exige string literal, así que el
// glob entra ya resuelto, junto con el nombre de carpeta de la marca.)
async function poblarPorCategoria(
  glob: Record<string, { default: ImageMetadata }>,
  marcaDir: string,
  tituloACarpeta: Record<string, string>
) {
  const porCategoria: Record<string, { path: string; meta: ImageMetadata }[]> = {};
  for (const [path, mod] of Object.entries(glob)) {
    const partes = decodeURIComponent(path).split('/');
    const idx = partes.indexOf(marcaDir);
    const categoria = partes[idx + 1]; // segmento inmediatamente tras la marca
    if (!categoria) continue;
    (porCategoria[categoria] ??= []).push({ path, meta: mod.default });
  }
  for (const item of recibidosRichItems) {
    const carpeta = tituloACarpeta[item.titulo];
    if (!carpeta) continue;
    const archivos = (porCategoria[carpeta] ?? [])
      .sort((a, b) => a.path.localeCompare(b.path, 'es'));
    if (archivos.length === 0) continue;
    pswpPorCategoria[item.titulo] = await Promise.all(
      archivos.map(({ meta }) => metaASlide(meta, item.titulo))
    );
  }
}

// --- Resimex: 2 niveles (categoría/archivo). Mapa título -> carpeta.
// No pluralizar: "Acero inoxidable" -> "Aceros" rompe cualquier regla. ---
if (d.slug === 'resimex' && recibidosRich) {
  const resimexGlob = import.meta.glob<{ default: ImageMetadata }>(
    '../../assets/catalogo_final/Resimex/**/*.{JPG,jpg,jpeg,png}',
    { eager: true }
  );
  await poblarPorCategoria(resimexGlob, 'Resimex', {
    'Aluminio': 'Aluminios',
    'Cobre': 'Cobres',
    'Acero inoxidable': 'Aceros',
    'Bronce': 'Bronces',
  });

  // Click por ítem: cada opción del .md (Perfil A, UBC, 304...) abre SOLO su foto.
  // El matching es por inclusión normalizada (sin acentos/mayúsculas/paréntesis)
  // porque los textos del .md no calzan literal con el archivo:
  //   "UBC (latas de aluminio)" -> "UBC.JPG"; "304" -> "Acero 304.JPG".
  const normalizar = (s: string) =>
    s
      .normalize('NFD')
      .replace(/[̀-ͯ]/g, '') // quita acentos (diacríticos NFD)
      .replace(/\(.*?\)/g, '')         // quita "(latas de aluminio)"
      .replace(/[^a-z0-9]+/gi, ' ')    // colapsa separadores
      .trim()
      .toLowerCase();

  const archivosResimex = Object.values(resimexGlob).map((mod) => {
    const meta = mod.default;
    const nombre = meta.src.split('/').at(-1) ?? '';
    return { meta, key: normalizar(decodeURIComponent(nombre).replace(/\.[^.]+$/, '')) };
  });

  // Excepciones item->archivo: typos del archivo (Calefont, Bronceo) o nombres
  // de contenido que no calzan literal (Tubo Limpio vs Tubo de cobre). El resto
  // resuelve solo por inclusión normalizada.
  const RESIMEX_ALIAS: Record<string, string> = {
    'CU Tubo': 'Tubo de cobre',
    'CU Tercera': 'Cobre de tercera',
    'CU Calefont': 'Calefont cobre',
    'CU Radiadores': 'Radiador cobre',
    'Bronce Colorado': 'Bronceo colorado',
  };

  for (const item of recibidosRichItems) {
    const opciones = Array.isArray(item.descripcion) ? item.descripcion : [item.descripcion];
    for (const opcion of opciones) {
      const objetivo = normalizar(RESIMEX_ALIAS[opcion] ?? opcion);
      if (!objetivo) continue;
      // El nombre del archivo contiene el texto del ítem ("Acero 304" ⊃ "304"),
      // o viceversa para nombres más cortos. Prioriza inclusión del item en archivo.
      const match =
        archivosResimex.find((a) => a.key.includes(objetivo)) ??
        archivosResimex.find((a) => objetivo.includes(a.key));
      if (match) pswpPorItem[opcion] = await metaASlide(match.meta, opcion);
    }
  }
}

// --- Econorte: estructura "Excedente de X/SubItem/fotos". Click por subitem:
// cada opción del .md (Catodos, SS 304, Manganeso...) abre SU foto. El matching
// es por PATH (carpeta-material + carpeta-subitem), no por nombre de archivo,
// así calza aunque el archivo se llame distinto (IMG_7296, Bolones de bronce...).
// Excepción: "Excedente de aluminio" no tiene subitems en el .md, así que su
// foto se cuelga a nivel-card (pswpPorCategoria), estilo Exxan.
if (d.slug === 'econorte' && recibidosRich) {
  const econorteGlob = import.meta.glob<{ default: ImageMetadata }>(
    '../../assets/catalogo_final/Econorte/**/*.{JPG,jpg,jpeg,png}',
    { eager: true }
  );

  const normalizar = (s: string) =>
    s
      .normalize('NFD')
      .replace(/[̀-ͯ]/g, '') // quita acentos (diacríticos NFD)
      .replace(/\(.*?\)/g, '')         // quita paréntesis
      .replace(/[^a-z0-9]+/gi, ' ')    // colapsa separadores
      .trim()
      .toLowerCase();

  // Indexa cada archivo por los segmentos de carpeta material/subitem (los dos
  // niveles bajo "Excedente de X/SubItem/"), ya normalizados.
  const archivosEconorte = Object.entries(econorteGlob).map(([path, mod]) => {
    const partes = decodeURIComponent(path).split('/');
    const idx = partes.findIndex((p) => /^Excedente de /i.test(p));
    return {
      meta: mod.default,
      path,
      material: idx >= 0 ? normalizar(partes[idx]) : '',
      subitem: idx >= 0 ? normalizar(partes[idx + 1] ?? '') : '',
    };
  });

  for (const item of recibidosRichItems) {
    const materialKey = normalizar(item.titulo);
    const delMaterial = archivosEconorte.filter((a) => a.material === materialKey);

    // Aluminio (y cualquier material sin subitems): foto a nivel-card.
    const opciones = Array.isArray(item.descripcion) ? item.descripcion : [item.descripcion];
    const sinSubitems = opciones.filter(Boolean).length === 0;
    if (sinSubitems) {
      const archivos = delMaterial.sort((a, b) => a.path.localeCompare(b.path, 'es'));
      if (archivos.length > 0) {
        pswpPorCategoria[item.titulo] = await Promise.all(
          archivos.map((a) => metaASlide(a.meta, item.titulo))
        );
      }
      continue;
    }

    // Resto: una foto por subitem, matcheando carpeta-subitem por inclusión.
    for (const opcion of opciones) {
      const objetivo = normalizar(opcion);
      if (!objetivo) continue;
      const match =
        delMaterial.find((a) => a.subitem === objetivo) ??
        delMaterial.find((a) => a.subitem.includes(objetivo)) ??
        delMaterial.find((a) => objetivo.includes(a.subitem) && a.subitem.length > 0);
      if (match) pswpPorItem[opcion] = await metaASlide(match.meta, opcion);
    }
  }
}

// --- Exxan: 2 niveles (carpeta-categoría/archivo), mismo patrón que Resimex y
// Econorte. Cada card-categoría agrupa todas las fotos de su carpeta. Mapa
// título -> carpeta. Fierro Oxicorte y Fierro Fundido aún no tienen fotos. ---
if (d.slug === 'exxan' && recibidosRich) {
  const exxanGlob = import.meta.glob<{ default: ImageMetadata }>(
    '../../assets/catalogo_final/Exxan/**/*.{JPG,jpg,jpeg,png}',
    { eager: true }
  );
  await poblarPorCategoria(exxanGlob, 'Exxan', {
    'Fierro Pesado': 'fierro_pesado',
    'Fierro Largo': 'fierro_largo',
    'Fierro Mixto': 'fierro_mixto',
    'Fierro Lata': 'fierro_lata',
    'Fierro Manganeso': 'fierro_manganeso',
  });
}
