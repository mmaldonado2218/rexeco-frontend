<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  type PswpSlide = { src: string; width: number; height: number; alt: string };

  document.addEventListener('click', (e) => {
    const card = (e.target as HTMLElement)?.closest<HTMLElement>('[data-pswp]');
    if (!card?.dataset.pswp) return;

    let slides: PswpSlide[];
    try {
      slides = JSON.parse(card.dataset.pswp);
    } catch {
      return;
    }
    if (!slides.length) return;

    const lightbox = new PhotoSwipeLightbox({
      dataSource: slides,
      pswpModule: () => import('photoswipe'),
      bgOpacity: 0.92,
    });

    // Título de la foto: PhotoSwipe v5 no trae caption de fábrica. Registramos
    // un elemento propio y leemos el texto del slide (`data.alt`, que poblamos
    // con el nombre del ítem). Se refresca en cada cambio por si el set navega.
    lightbox.on('uiRegister', () => {
      lightbox.pswp?.ui?.registerElement({
        name: 'pswp-caption',
        order: 9,
        isButton: false,
        appendTo: 'root',
        onInit: (el, pswp) => {
          el.className = 'pswp-caption';
          const render = () => {
            const texto = pswp.currSlide?.data?.alt ?? '';
            el.innerHTML = texto;
            el.style.display = texto ? 'block' : 'none';
          };
          pswp.on('change', render);
          render();
        },
      });
    });

    lightbox.on('close', () => lightbox.destroy());
    lightbox.init();
    lightbox.loadAndOpen(0);
  });
</script>

<style is:global>
  /* Caption del lightbox: vive en .pswp (fuera del componente), por eso global.
     Usa Rajdhani (--font-heading), la tipografía de marca para títulos. */
  .pswp-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 28px 20px calc(22px + env(safe-area-inset-bottom, 0px));
    text-align: center;
    font-family: var(--font-heading), "Rajdhani", sans-serif;
    font-size: clamp(1.05rem, 1rem + 1vw, 1.6rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.55);
    background: linear-gradient(to top, rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0));
    pointer-events: none;
    z-index: 10;
  }

  /* Acento de marca: una línea roja corta encima del texto. */
  .pswp-caption::before {
    content: "";
    display: block;
    width: 32px;
    height: 3px;
    margin: 0 auto 10px;
    border-radius: 2px;
    background: var(--color-rexeco-red, #CC0A26);
  }
</style>
